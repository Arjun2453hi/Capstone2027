.ruff_cache/
venv/
.venv/

# Downloaded model caches / embedding caches — regenerated per run, not source
**/.cache/
**/.cache/embeddings/

# Node (frontend)
node_modules/
dist/

# Editors
.vscode/
.idea/
.DS_Store
