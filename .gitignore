# Secrets — never commit real values
.env
**/.env
Confusion_Detection/backend/.env
.env.groq-rotation
**/.env.groq-rotation
# Other local environment variants; keep credential-free example templates.
.env.*
!.env.example
!.env.*.example

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/
venv/
.venv/

# Downloaded model caches / embedding caches — regenerated per run, not source
**/.cache/
**/.cache/embeddings/

# Node (frontend)
node_modules/
dist/

# Editors
.vscode/
.idea/
.DS_Store

# Agentic editor: the edited deck is regenerated from edit_plan.json
Confusion_Detectionv2/05_agentic_editor/output/*.pptx
Confusion_Detectionv2/05_agentic_editor/output/demo_*

# Deck workspaces: copied source files, local editor state and logs stay local;
# manifests, questions and stage outputs are small and are committed.
Confusion_Detectionv2/decks/*/source.pdf
Confusion_Detectionv2/decks/*/source.pptx
Confusion_Detectionv2/decks/*/editor/workspace/
Confusion_Detectionv2/decks/*/editor/*.pptx
Confusion_Detectionv2/decks/*/editor/*.pdf
Confusion_Detectionv2/decks/*/pipeline.log
Confusion_Detectionv2/decks/*/last_run.txt
Confusion_Detectionv2/eval/reports/**/run.log
