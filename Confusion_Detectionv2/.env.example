# Copy this file to .env and fill in real values. .env is gitignored;
# this template is committed so the required variable names are documented.

# Used by 03_question_mapping's LLM fallback (ambiguous question-topic
# scores only -- most questions resolve via semantic similarity alone,
# never reaching this). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq's hosted model lineup changes over time (llama-3.3-70b-versatile,
# used previously, was removed entirely). Keeping the model name here
# instead of hardcoded means a future drift is a one-line config change,
# not a code change -- GroqAmbiguityResolver validates this against
# Groq's live model list at startup and fails loudly if it's gone.
GROQ_MODEL_NAME=openai/gpt-oss-20b

# Used by 04_gap_reporting_agent's per-topic investigation agent to
# trace every LLM call and tool call (LangSmith) -- required per that
# stage's CLAUDE.md, since inspecting the agent's actual investigation
# process (not just its final answer) is how agent output gets trusted.
# Get a free key at https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=confusion-detection-v2
